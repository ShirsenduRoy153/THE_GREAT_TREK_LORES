# ==============================================================================
# The Great Trek Lores — Environment Configuration Example
# ==============================================================================

# Database Configuration (Defaults to local Docker Postgres)
# For production zero-cost hosting, use your Neon.tech connection string:
# jdbc:postgresql://ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/great_trek_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword

# JWT Security
# Minimum 32-character secret key for HMAC-SHA256
JWT_SECRET=superSecretKeyForTheGreatTrekLoresDemoMustBeLongEnough1234567890
JWT_EXPIRATION_MS=86400000

# Cloudinary Storage (Zero-Cost Free Tier for Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Server Port
PORT=8080

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8080/api
